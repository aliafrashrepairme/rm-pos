# Copy to .env and fill in the values from Supabase Project Settings > API Keys.
# .env is for a test project (npm run dev). The real shop's values go in .env.live (npm run live),
# and .env.production holds only VITE_API_URL for the installer. Git ignores all three; never commit them.
VITE_API_URL=http://localhost:4000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: comma-separated browser origins allowed to call the API. The desktop app is always allowed. Defaults to the Vite dev server.
CORS_ORIGINS=
# Set to 1 when the API runs behind one hosting proxy, so login limits see real addresses.
TRUST_PROXY=
# Only for npm --prefix server run db:migrate. Never set this on the hosted API.
SUPABASE_DB_URL=
